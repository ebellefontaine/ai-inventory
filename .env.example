AIINV_DATABASE_URL=postgres://aiinv:aiinv@localhost:5432/aiinv?sslmode=disable
AIINV_LISTEN_ADDR=:8080
AIINV_LOG_LEVEL=info

# Fleet behaviour. The heartbeat interval is returned to every agent in its
# registration response, so changing it here and restarting the server retunes
# the whole fleet -- agents do not need redeploying.
AIINV_HEARTBEAT_INTERVAL_SECONDS=60

# An agent goes idle after this many missed heartbeats, then stale after this
# many days of silence. Nothing is ever deleted: a stale record is an audit
# finding, not cleanup work.
AIINV_IDLE_AFTER_MISSED_BEATS=3
AIINV_STALE_AFTER_DAYS=7
